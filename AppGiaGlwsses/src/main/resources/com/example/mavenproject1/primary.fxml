<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: #edbb99;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mavenproject1.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label style="-fx-font-size: 14;" text="Επιλογή Γλώσσας" textAlignment="CENTER">
      <font>
         <Font size="29.0" />
      </font></Label>
    <ComboBox fx:id="languageCombo" prefWidth="200" />
    <Label style="-fx-font-size: 14;" text="Επιλογή Κατηγορίας" textAlignment="CENTER" />
    <ComboBox fx:id="categoryCombo" prefWidth="200" />
     <Button fx:id="continueButton" onAction="#handleContinue" text="Continue" />
    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleQuiz" prefHeight="26.0" prefWidth="87.0" text="Take Quiz" />
    </HBox>
   <effect>
      <InnerShadow />
   </effect>
</VBox>
