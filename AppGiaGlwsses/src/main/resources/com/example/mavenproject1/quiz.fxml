<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #edbb99;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mavenproject1.QuizController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Translation Quiz" />
    <Label fx:id="questionLabel" alignment="CENTER" style="-fx-font-size: 18px;" wrapText="true" />
    <TextField fx:id="answerField" prefWidth="300" promptText="Type the English translation here" />
    <Label fx:id="feedbackLabel" alignment="CENTER" style="-fx-font-size: 14px;" wrapText="true" />
    <Label fx:id="scoreLabel" alignment="CENTER" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    
    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleCheckAnswer" style="-fx-font-size: 14px;" text="Check Answer" />
        <Button onAction="#handleNextQuestion" style="-fx-font-size: 14px;" text="Next Question" />
        <Button onAction="#switchToPrimary" style="-fx-font-size: 14px;" text="Go Back" />
    </HBox>
   <effect>
      <InnerShadow />
   </effect>
</VBox>
