<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #edbb99;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mavenproject1.SecondaryController">
    <children>
        <Label text="Secondary View" />
        <Label fx:id="selectedLanguageLabel" text="Selected Language: " />
        <Label fx:id="selectedCategoryLabel" text="Selected Category: " />
        <Label fx:id="phrasesLabel" text="Phrases: " />
        <Button fx:id="backButton" onAction="#switchToPrimary" text="Go Back" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <effect>
      <InnerShadow />
   </effect>
</VBox>
